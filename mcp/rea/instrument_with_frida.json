{"name":"instrument_with_frida","description":"Run one caller-authored Frida script against an explicitly selected process and detach when the observation window ends. The CLI and MCP share this ephemeral workflow; use MCP session operations for persistent sessions. Remote authentication is used only for this call and excluded from Evidence.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"examples":[{"device_id":"local","duration_ms":1000,"mode":"attach","pid":1234,"source":"send(Process.id);","source_kind":"inline"}],"properties":{"argv":{"items":{"type":"string"},"type":"array"},"device_id":{"minLength":1,"type":"string"},"duration_ms":{"default":1000,"maximum":60000,"minimum":0,"type":"integer"},"mode":{"description":"Operation mode that selects the requested behavior.","enum":["attach","spawn"],"type":"string"},"path":{"description":"Local filesystem path used by this operation.","minLength":1,"pattern":"^[^\\x00]*$","type":"string"},"pid":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"program":{"minLength":1,"pattern":"^[^\\x00]*$","type":"string"},"remote":{"additionalProperties":false,"properties":{"address":{"maxLength":2048,"minLength":1,"type":"string"},"certificate":{"minLength":1,"type":"string"},"keepalive_interval":{"description":"Remote keepalive interval in seconds","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"origin":{"minLength":1,"type":"string"},"token":{"minLength":1,"type":"string"}},"required":["address"],"type":"object"},"source":{"type":"string"},"source_kind":{"enum":["inline","file"],"type":"string"}},"required":["mode","source_kind"],"type":"object"}}