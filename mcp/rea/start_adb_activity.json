{"name":"start_adb_activity","description":"Start an intent with `am start -W`: one action, optional data URI, optional explicit component, and up to 16 typed extras (string, boolean, int, long, float). A device-mutating tool; the full wait report determines success, with failed-attempt facts and raw output retained.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"examples":[{"action":"android.intent.action.VIEW","data_uri":"https://example.com/path","serial":"emulator-5554"},{"action":"com.example.APP_ACTION","extras":[{"key":"level","type":"int","value":"3"}],"serial":"emulator-5554"}],"properties":{"action":{"description":"Intent action to start","maxLength":256,"minLength":1,"pattern":"^[A-Za-z][A-Za-z0-9._\\x2d]*$","type":"string"},"component":{"description":"Explicit component to start (-n)","maxLength":512,"minLength":1,"pattern":"^[A-Za-z0-9._\\x2d]+(\\/[A-Za-z0-9._\\x2d]*)?$","type":"string"},"data_uri":{"description":"Intent data URI (-d)","maxLength":2048,"minLength":1,"pattern":"^[^\\x00\\s]+$","type":"string"},"extras":{"default":[],"description":"Typed intent extras (--es/--ez/--ei/--el/--ef)","items":{"oneOf":[{"additionalProperties":false,"properties":{"key":{"description":"Extra key","maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9._\\x2d]+$","type":"string"},"type":{"const":"string","description":"String extra value type","type":"string"},"value":{"description":"String extra value as text; an explicitly empty value is preserved","maxLength":2048,"pattern":"^[^\\x00]*$","type":"string"}},"required":["key","type","value"],"type":"object"},{"additionalProperties":false,"properties":{"key":{"description":"Extra key","maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9._\\x2d]+$","type":"string"},"type":{"const":"boolean","description":"Boolean extra value type","type":"string"},"value":{"allOf":[{"pattern":"^[^\\x00]*$"},{"pattern":"^(true|false)$"}],"description":"Boolean extra value as true or false text","maxLength":2048,"minLength":1,"type":"string"}},"required":["key","type","value"],"type":"object"},{"additionalProperties":false,"properties":{"key":{"description":"Extra key","maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9._\\x2d]+$","type":"string"},"type":{"const":"int","description":"Integer extra value type","type":"string"},"value":{"allOf":[{"pattern":"^[^\\x00]*$"},{"pattern":"^-?\\d+$"}],"description":"Integer extra value as signed decimal text","maxLength":2048,"minLength":1,"type":"string"}},"required":["key","type","value"],"type":"object"},{"additionalProperties":false,"properties":{"key":{"description":"Extra key","maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9._\\x2d]+$","type":"string"},"type":{"const":"long","description":"Long extra value type","type":"string"},"value":{"allOf":[{"pattern":"^[^\\x00]*$"},{"pattern":"^-?\\d+$"}],"description":"Long extra value as signed decimal text","maxLength":2048,"minLength":1,"type":"string"}},"required":["key","type","value"],"type":"object"},{"additionalProperties":false,"properties":{"key":{"description":"Extra key","maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9._\\x2d]+$","type":"string"},"type":{"const":"float","description":"Float extra value type","type":"string"},"value":{"allOf":[{"pattern":"^[^\\x00]*$"},{"pattern":"^-?\\d+(\\.\\d+)?$"}],"description":"Float extra value as decimal text","maxLength":2048,"minLength":1,"type":"string"}},"required":["key","type","value"],"type":"object"}]},"maxItems":16,"type":"array"},"serial":{"description":"Device serial exactly as `adb devices` reports it","maxLength":256,"minLength":1,"pattern":"^[^\\x00\\s\"']+$","type":"string"}},"required":["serial","action"],"type":"object"}}